# Copy to .env and fill values
# SMTP settings for nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Basileus Backups <backups@example.com>"

# Company email to receive backups (defaults to the SMTP user if not set)
COMPANY_BACKUP_EMAIL=basileuosinvestments@gmail.com

# Optional API key to protect the backup endpoint
API_KEY=some-secret-key

# Server port
PORT=3000
